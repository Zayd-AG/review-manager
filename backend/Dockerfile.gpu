# CUDA-enabled variant for local NVIDIA GPU inference.
# Docker Desktop supplies the host GPU driver; this image supplies the matching
# CUDA-enabled PyTorch wheel.
FROM python:3.11-slim

WORKDIR /app

# Triton compiles a small CUDA helper on the first GPU inference.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu130 torch==2.13.0 \
    && pip install --no-cache-dir -r requirements.txt

COPY backend ./backend
COPY finetuning/prepare_dataset.py ./finetuning/prepare_dataset.py
COPY labeling/prompts.py ./labeling/prompts.py

EXPOSE 8000

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
